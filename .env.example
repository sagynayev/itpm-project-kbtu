DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL=false
# Production alternative to the POSTGRES_* variables below:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
POSTGRES_DB=pdd_chatbot
POSTGRES_USER=pdd_chatbot
POSTGRES_PASSWORD=pdd_chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
VITE_API_URL=http://localhost:8000/api
PDD_RETRIEVAL_MIN_SCORE=0.34

